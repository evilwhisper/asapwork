# Auto-generated on first run — copy to .env and fill in values

# Deployment mode: local | docker-local | cloud | codespace
DEPLOY_MODE=local

# Encryption key for API keys at rest (auto-generated if missing)
ENCRYPTION_KEY=

# Database — defaults to SQLite; swap to asyncpg URL for PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./job_agent.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/job_agent

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# Auth — only used when DEPLOY_MODE=cloud
AUTH_ENABLED=false
ADMIN_USER=admin
ADMIN_PASS_HASH=

# App version
APP_VERSION=0.1.0
