{
  "name": "job-agent",
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"uvicorn backend.main:app --reload --port 8000\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install && cd frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
